<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<title>コード確認</title>
<style>
  :root{--ink:#1d1d1f;--sub:#6e6e73;--line:#e5e5ea;--fill:#f5f5f7;--accent:#0071e3;--ng:#c7500f;}
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  body{margin:0;background:#fff;color:var(--ink);line-height:1.6;
    font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Noto Sans JP",sans-serif;
    -webkit-font-smoothing:antialiased;}
  .wrap{max-width:620px;margin:0 auto;padding:26px 20px 80px;}
  h1{font-size:22px;font-weight:600;margin:0 0 4px;}
  .sub{color:var(--sub);font-size:14px;margin:0 0 26px;}
  .field{display:flex;gap:8px;}
  input{
    flex:1;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:19px;letter-spacing:.08em;
    padding:13px 15px;border:1px solid var(--line);border-radius:12px;background:var(--fill);color:var(--ink);
    text-transform:uppercase;min-width:0;
  }
  input:focus{outline:2px solid var(--accent);outline-offset:1px;background:#fff;}
  button{font-family:inherit;font-size:15px;cursor:pointer;border-radius:12px;border:0;
    background:var(--accent);color:#fff;padding:13px 22px;}
  .out{margin-top:26px;}
  .err{background:#fdf6f1;border-left:3px solid var(--ng);border-radius:0 10px 10px 0;padding:14px 16px;font-size:14.5px;}
  .meta{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 20px;}
  .chip{background:var(--fill);border-radius:999px;padding:6px 13px;font-size:12.5px;color:var(--sub);}
  h2{font-size:13px;font-weight:600;color:var(--sub);letter-spacing:.04em;margin:24px 0 12px;}
  ol{list-style:none;counter-reset:s;margin:0;padding:0;}
  ol li{counter-increment:s;position:relative;padding:0 0 18px 38px;}
  ol li::before{content:counter(s);position:absolute;left:0;top:2px;width:24px;height:24px;border-radius:50%;
    background:var(--ink);color:#fff;font-size:12px;font-weight:600;display:flex;align-items:center;justify-content:center;}
  ol li:not(:last-child)::after{content:"";position:absolute;left:11.5px;top:30px;bottom:4px;width:1px;background:var(--line);}
  ol .lb{font-size:15.5px;margin:0;}
  ol .id{font-family:ui-monospace,Menlo,monospace;font-size:11.5px;color:#a1a1a6;margin:2px 0 0;}
  .final{background:var(--fill);border-radius:14px;padding:16px 18px;margin-top:4px;}
  .final .t{font-size:16px;font-weight:600;margin:0 0 4px;}
  .final a{color:var(--accent);font-size:14px;text-decoration:none;}
  .foot{margin-top:34px;padding-top:20px;border-top:1px solid var(--line);color:var(--sub);font-size:13px;}
</style>
</head>
<body>
<div class="wrap">
  <h1>コード確認</h1>
  <p class="sub">購入者から届いたエラーコードを入力すると、通った経路を確認できます。</p>

  <div class="field">
    <input id="code" placeholder="TS-112D-U" autocomplete="off" autocapitalize="characters" spellcheck="false">
    <button id="go">確認</button>
  </div>

  <div class="out" id="out"></div>

  <p class="foot">
    このページは検索エンジンに登録されない設定にしていますが、URL を知っていれば誰でも開けます。
    表示されるのは分岐の内容だけで、購入者を特定できる情報は含まれません。
  </p>
</div>

<script src="flow.js"></script>
<script>
(function(){
  var input = document.getElementById('code');
  var out   = document.getElementById('out');

  function esc(s){ return String(s).replace(/[&<>"]/g, function(c){
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }

  function render(){
    var r = decodeCode(input.value);
    if (!r.ok) { out.innerHTML = '<div class="err">' + esc(r.reason) + '</div>'; return; }

    var html = '<div class="meta">';
    html += '<span class="chip">フロー改訂 ' + esc(r.version) + '</span>';
    if (r.version !== FLOW_VERSION) {
      html += '<span class="chip" style="color:#c7500f">現在は改訂 ' + esc(FLOW_VERSION) + '：当時の文言と異なります</span>';
    }
    html += '<span class="chip">経路 ' + r.segs.length + ' ステップ</span>';
    html += '</div>';

    if (!r.segs.length) {
      html += '<div class="err">' + esc(r.note) + '</div>';
      out.innerHTML = html; return;
    }

    html += '<h2>購入者が選んだ内容</h2><ol>';
    r.trail.forEach(function(s){
      html += '<li><p class="lb">' + esc(s.label) + '</p><p class="id">' + esc(s.id) +
              (s.idx === 9 ? '（関連リンク・直接リンク経由）' : '') + '</p></li>';
    });
    html += '</ol>';

    var lastId = r.segs[r.segs.length-1];
    var last = NODES[lastId];
    html += '<h2>最後に開いたページ</h2><div class="final">';
    html += '<p class="t">' + esc(last.title) + '</p>';
    html += '<a href="index.html' + buildHash(r.segs, false) + '" target="_blank" rel="noopener">同じ画面を開く →</a>';
    html += '</div>';

    out.innerHTML = html;
  }

  document.getElementById('go').addEventListener('click', render);
  input.addEventListener('keydown', function(e){ if (e.key === 'Enter') render(); });
})();
</script>
</body>
</html>
