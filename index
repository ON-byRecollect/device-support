<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Apple製品 トラブルシューティング</title>
<meta name="description" content="質問に答えるだけで、AirPods や Apple Watch の不具合の対処法をご案内します。">
<style>
  :root{
    --bg:#ffffff; --ink:#1d1d1f; --sub:#6e6e73; --line:#e5e5ea;
    --fill:#f5f5f7; --accent:#0071e3; --warn:#c7500f; --radius:14px;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html,body{margin:0;padding:0;background:var(--bg);color:var(--ink);}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Noto Sans JP",sans-serif;
    -webkit-font-smoothing:antialiased; line-height:1.6;
  }
  #root{max-width:640px;margin:0 auto;padding:0 20px calc(72px + env(safe-area-inset-bottom));}

  header.site{padding:22px 0 18px;display:flex;align-items:center;justify-content:space-between;gap:12px;}
  .brand{font-size:15px;font-weight:600;margin:0;}
  .brand span{color:var(--sub);font-weight:400;}
  .restart{border:0;background:none;color:var(--accent);font-size:14px;font-family:inherit;cursor:pointer;padding:6px 0;}
  .restart:disabled{opacity:.3;cursor:default;}

  .trail{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:26px;}
  .trail button{
    font-family:inherit;font-size:12.5px;line-height:1;padding:7px 12px;border-radius:999px;
    border:1px solid var(--line);background:var(--fill);color:var(--sub);cursor:pointer;
  }
  .trail button:hover{color:var(--ink);}
  .trail .sep{color:#c7c7cc;font-size:12px;align-self:center;}

  h1.q{font-size:30px;line-height:1.3;font-weight:600;letter-spacing:-.02em;margin:0 0 10px;}
  p.hint{margin:0 0 26px;color:var(--sub);font-size:15px;}

  .options{display:flex;flex-direction:column;gap:10px;}
  .opt{
    width:100%;text-align:left;font-family:inherit;cursor:pointer;background:var(--fill);
    border:1px solid transparent;border-radius:var(--radius);padding:16px 46px 16px 18px;
    position:relative;color:var(--ink);transition:background .15s ease, transform .15s ease;
  }
  .opt:hover{background:#ececf0;}
  .opt:active{transform:scale(.99);}
  .opt:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}
  .opt .label{font-size:16.5px;font-weight:500;display:block;}
  .opt .sub{font-size:13.5px;color:var(--sub);display:block;margin-top:3px;}
  .opt::after{
    content:"";position:absolute;right:20px;top:50%;width:7px;height:7px;margin-top:-4px;
    border-right:1.8px solid #b0b0b8;border-top:1.8px solid #b0b0b8;transform:rotate(45deg);
  }
  .opt.product{padding:22px 46px 22px 20px;background:#fff;border-color:var(--line);}
  .opt.product .label{font-size:19px;font-weight:600;}

  .eyebrow{font-size:12.5px;font-weight:600;color:var(--accent);letter-spacing:.04em;margin:0 0 8px;}
  .lead{font-size:16px;color:var(--sub);margin:0 0 28px;}

  .callout{
    border-left:3px solid var(--warn);background:#fdf6f1;border-radius:0 10px 10px 0;
    padding:14px 16px;margin:0 0 28px;font-size:14.5px;
  }
  .callout p{margin:0;}

  ol.steps{list-style:none;counter-reset:s;margin:0;padding:0;}
  ol.steps > li{counter-increment:s;position:relative;padding:0 0 28px 42px;}
  ol.steps > li::before{
    content:counter(s);position:absolute;left:0;top:1px;width:26px;height:26px;border-radius:50%;
    background:var(--ink);color:#fff;font-size:13px;font-weight:600;
    display:flex;align-items:center;justify-content:center;
  }
  ol.steps > li:not(:last-child)::after{
    content:"";position:absolute;left:12.5px;top:32px;bottom:8px;width:1px;background:var(--line);
  }
  ol.steps p{margin:0;font-size:16px;}
  ol.steps .quiet{color:var(--sub);font-size:14.5px;margin-top:10px;}

  .variants{display:flex;flex-direction:column;gap:8px;margin:14px 0 0;}
  .variant{background:var(--fill);border-radius:12px;padding:14px 16px;}
  .variant .vname{font-size:15px;font-weight:600;margin:0 0 4px;}
  .variant .vtext{font-size:14px;color:var(--sub);margin:0;}

  figure{margin:14px 0 0;}
  figure img{display:block;width:100%;border-radius:10px;border:1px solid var(--line);}
  figcaption{font-size:12.5px;color:var(--sub);margin-top:6px;}
  .ph{
    border:1px dashed #c7c7cc;border-radius:10px;background:repeating-linear-gradient(
      45deg,#fafafa,#fafafa 8px,#f2f2f4 8px,#f2f2f4 16px);
    padding:28px 16px;text-align:center;color:#8e8e93;font-size:12.5px;
  }
  .ph .phname{display:block;font-size:13px;color:var(--sub);margin-top:6px;font-weight:500;}

  .note{background:var(--fill);border-radius:var(--radius);padding:16px 18px;font-size:14.5px;color:var(--sub);margin:6px 0 0;}
  .note strong{color:var(--ink);font-weight:600;}

  .pending{border:1px dashed var(--line);border-radius:var(--radius);padding:24px 20px;color:var(--sub);font-size:15px;}

  .resolve{margin-top:38px;padding-top:26px;border-top:1px solid var(--line);}
  .resolve h2{font-size:17px;font-weight:600;margin:0 0 14px;}
  .row{display:flex;gap:10px;flex-wrap:wrap;}
  .btn{
    font-family:inherit;font-size:15px;cursor:pointer;padding:12px 22px;border-radius:999px;
    border:1px solid var(--line);background:#fff;color:var(--ink);
  }
  .btn.primary{background:var(--accent);color:#fff;border-color:var(--accent);}
  .btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}

  .codecard{
    background:var(--ink);color:#fff;border-radius:18px;padding:26px 22px;text-align:center;margin:0 0 22px;
  }
  .codecard .clabel{font-size:12.5px;color:#a1a1a6;margin:0 0 10px;letter-spacing:.04em;}
  .codecard .code{
    font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
    font-size:30px;font-weight:600;letter-spacing:.12em;margin:0;
  }
  .copy{margin-top:16px;background:#fff;color:var(--ink);border:0;border-radius:999px;
    padding:10px 20px;font-family:inherit;font-size:14px;cursor:pointer;}

  .fade{animation:fade .28s ease both;}
  @keyframes fade{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:none;}}
  @media (prefers-reduced-motion:reduce){.fade{animation:none;} *{transition:none !important;}}
  @media (max-width:420px){h1.q{font-size:25px;} .codecard .code{font-size:25px;}}
</style>
</head>
<body>
<div id="root"></div>

<script src="https://unpkg.com/react@18.3.1/umd/react.production.min.js" crossorigin></script>
<script src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js" crossorigin></script>
<script src="https://unpkg.com/@babel/standalone@7.26.4/babel.min.js" crossorigin></script>

<script type="text/babel">
const { useState, useCallback, useMemo } = React;

/* ============================================================
   診断フロー定義
   type:'question' … 質問画面
   type:'answer'   … 対処法画面（steps / variants / image / note）
   type:'pending'  … 原稿準備中のプレースホルダ
   画像は images/ に配置。未配置のあいだは自動で仮ボックスを表示。
   ============================================================ */
const NODES = {

