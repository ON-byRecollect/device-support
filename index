const CONTACT = 'ご購入いただいた取引メッセージよりご連絡ください。';

/* ---------- エラーコード（暫定仕様） ----------
   選択した選択肢の番号を連結して36進数に変換し、末尾に検査文字を付与。
   管理者サイト側で逆変換すると、通過した選択肢を復元できます。
   ※ 分岐を変更すると過去のコードの意味が変わるため、
      本番運用前に方式を確定させます。
------------------------------------------------ */
function makeCode(path){
  const digits = path.map(s => String(s.idx)).join('');
  const n = parseInt('1' + digits, 10);
  const body = n.toString(36).toUpperCase().padStart(4,'0');
  const sum = [...body].reduce((a,c)=>a+c.charCodeAt(0),0) % 36;
  const check = sum.toString(36).toUpperCase();
  return 'TS-' + body + '-' + check;
}

/* ---------- 画像（未配置なら仮ボックス） ---------- */
function Figure({ src, caption }){
  const [failed, setFailed] = useState(false);
  if (!src) return null;
  return (
    <figure>
      {failed
        ? <div className="ph">画像を配置してください<span className="phname">{src}</span></div>
        : <img src={src} alt={caption || ''} loading="lazy" onError={()=>setFailed(true)} />}
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  );
}

function Trail({ path, onJump }){
  if (!path.length) return null;
  return (
    <nav className="trail" aria-label="選択した内容">
      {path.map((s,i)=>(
        <React.Fragment key={i}>
          {i>0 && <span className="sep" aria-hidden="true">›</span>}
          <button onClick={()=>onJump(i)}>{s.label}</button>
        </React.Fragment>
      ))}
    </nav>
  );
}

function Question({ node, onSelect }){
  return (
    <div className="fade">
      <h1 className="q">{node.title}</h1>
      {node.hint && <p className="hint">{node.hint}</p>}
      <div className="options">
        {node.options.map((o,i)=>(
          <button key={i} className={'opt' + (node.product ? ' product' : '')} onClick={()=>onSelect(o,i)}>
            <span className="label">{o.label}</span>
            {o.sub && <span className="sub">{o.sub}</span>}
          </button>
        ))}
      </div>
    </div>
  );
}

function Answer({ node, onBack, onRestart, onUnresolved, onGoto }){
  return (
    <div className="fade">
      {node.eyebrow && <p className="eyebrow">{node.eyebrow}</p>}
      <h1 className="q">{node.title}</h1>
      {node.lead && <p className="lead">{node.lead}</p>}
      {node.callout && <div className="callout"><p>{node.callout}</p></div>}

      <ol className="steps">
        {node.steps.map((s,i)=>(
          <li key={i}>
            <p>{s.text}</p>
            {s.variants && (
              <div className="variants">
                {s.variants.map((v,j)=>(
                  <div className="variant" key={j}>
                    <p className="vname">{v.name}</p>
                    <p className="vtext">{v.text}</p>
                  </div>
                ))}
              </div>
            )}
            <Figure src={s.image} caption={s.caption} />
            {s.after && <p className="quiet">{s.after}</p>}
          </li>
        ))}
      </ol>

      {node.note && <p className="note" dangerouslySetInnerHTML={{__html:node.note}} />}

      {node.nextLink && (
        <div className="row" style={{marginTop:'22px'}}>
          <button className="btn" onClick={()=>onGoto(node.nextLink.to, node.nextLink.label)}>
            {node.nextLink.label}
          </button>
        </div>
      )}

      <div className="resolve">
        <h2>解決しましたか？</h2>
        <div className="row">
          <button className="btn primary" onClick={onRestart}>解決した</button>
          <button className="btn" onClick={onUnresolved}>解決しない</button>
          <button className="btn" onClick={onBack}>ひとつ前に戻る</button>
        </div>
      </div>
    </div>
  );
}

function Pending({ node, onBack }){
  return (
    <div className="fade">
      <p className="eyebrow">準備中</p>
      <h1 className="q">{node.title}</h1>
      <div className="pending">この項目の手順は現在準備中です。お急ぎの場合は、{CONTACT}</div>
      <div className="resolve">
        <div className="row"><button className="btn" onClick={onBack}>ひとつ前に戻る</button></div>
      </div>
    </div>
  );
}

function Unresolved({ code, onBack, onRestart }){
  const [copied, setCopied] = useState(false);
  const copy = () => {
    if (!navigator.clipboard) return;
    navigator.clipboard.writeText(code).then(()=>{
      setCopied(true); setTimeout(()=>setCopied(false), 2000);
    }).catch(()=>{});
  };
  return (
    <div className="fade">
      <p className="eyebrow">お問い合わせ</p>
      <h1 className="q">担当者が状況を確認します</h1>
      <p className="lead">下のコードを取引メッセージにそのまま貼り付けてお送りください。ここまでに選んだ内容が担当者側で確認でき、やり取りが一度で済みます。</p>

      <div className="codecard">
        <p className="clabel">エラーコード</p>
        <p className="code">{code}</p>
        <button className="copy" onClick={copy}>{copied ? 'コピーしました' : 'コードをコピー'}</button>
      </div>

      <p className="note">
        <strong>お送りいただく内容：</strong>エラーコードと、お使いの端末（iPhone / iPad など）の機種名をあわせてお知らせください。
      </p>

      <div className="resolve">
        <div className="row">
          <button className="btn" onClick={onBack}>ひとつ前に戻る</button>
          <button className="btn" onClick={onRestart}>最初から調べ直す</button>
        </div>
      </div>
    </div>
  );
}

function App(){
  const [path, setPath] = useState([]);      // [{label, id, idx}]
  const [unresolved, setUnresolved] = useState(false);

  const currentId = path.length ? path[path.length-1].id : 'start';
  const node = NODES[currentId] || NODES.start;
  const code = useMemo(()=>makeCode(path), [path]);

  const go = (label, id, idx) => {
    setUnresolved(false);
    setPath(p => [...p, { label:label, id:id, idx:idx }]);
    window.scrollTo({ top:0 });
  };
  const select = useCallback((o,i)=>go(o.label, o.next, i), []);
  const goto = useCallback((id,label)=>go(label, id, 9), []);
  const back = useCallback(()=>{
    if (unresolved) { setUnresolved(false); return; }
    setPath(p=>p.slice(0,-1)); window.scrollTo({top:0});
  }, [unresolved]);
  const jump = useCallback((i)=>{ setUnresolved(false); setPath(p=>p.slice(0,i)); window.scrollTo({top:0}); }, []);
  const restart = useCallback(()=>{ setUnresolved(false); setPath([]); window.scrollTo({top:0}); }, []);

  let body;
  if (unresolved) {
    body = <Unresolved code={code} onBack={back} onRestart={restart} />;
  } else if (node.type === 'answer') {
    body = <Answer node={node} onBack={back} onRestart={restart} onGoto={goto}
             onUnresolved={()=>{ setUnresolved(true); window.scrollTo({top:0}); }} />;
  } else if (node.type === 'pending') {
    body = <Pending node={node} onBack={back} />;
  } else {
    body = <Question node={node} onSelect={select} />;
  }

  return (
    <React.Fragment>
      <header className="site">
        <p className="brand">Apple製品 <span>トラブルシューティング</span></p>
        <button className="restart" onClick={restart} disabled={!path.length && !unresolved}>最初から</button>
      </header>
      <Trail path={path} onJump={jump} />
      {body}
    </React.Fragment>
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(<App />);
</script>
</body>
</html>
